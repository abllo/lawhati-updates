.iph{display:flex;flex-direction:column;gap:18px;padding-bottom:8px;max-width:1100px}
.iph-hero{display:flex;align-items:center;gap:16px;padding:18px 20px;border-radius:24px;border:1px solid var(--line);background:linear-gradient(150deg,rgba(var(--accent-rgb),.16),rgba(255,255,255,.03) 60%)}
.iph-dev{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;background:rgba(var(--accent-rgb),.16);color:var(--accent);flex:none}
.iph-dev svg{width:32px;height:32px}
.iph-t{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
.iph-t > b{font-family:var(--f-display);font-weight:600;font-size:24px;line-height:1.2}
.iph-st{display:inline-flex;align-items:center;gap:7px;font-size:14px;color:var(--muted)}
.iph-st::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--faint)}
.iph-st.live::before{background:var(--ok);box-shadow:0 0 0 4px rgba(76,211,160,.18)}
.iph-st.poll::before{background:var(--amber)}
.iph-st.off::before{background:var(--warn)}
.iph-s{font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.iph-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px}
.iph-c{display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-height:170px;padding:16px 18px;border-radius:22px;border:1px solid var(--line);background:linear-gradient(160deg,rgba(255,255,255,.09),rgba(255,255,255,.03))}
.iph-c > .btn{margin-top:auto}
.iph-k{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:14px}
.iph-k span{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:rgba(var(--accent-rgb),.13);color:var(--accent)}
.iph-k svg{width:17px;height:17px}
.iph-k b{font-weight:500}
.iph-n{font-family:var(--f-display);font-weight:600;font-size:21px;line-height:1.3;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.iph-row{display:flex;gap:8px;margin-top:auto}
.iph-c .btn svg,.iph-hero .btn svg{width:18px;height:18px}
.iph-sec{display:flex;flex-direction:column;gap:10px}
.iph-sec h3{display:flex;align-items:center;gap:8px;margin:0;font-size:14px;font-weight:500;color:var(--muted)}
.iph-sec h3 svg{width:17px;height:17px}
.iph-sc{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.iph-scb{display:flex;align-items:center;gap:10px;min-height:54px;padding:0 14px;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--faint)}
.iph-scb span{display:grid;place-items:center;color:var(--faint)}
.iph-scb svg{width:19px;height:19px}
.iph-scb b{flex:1;font-weight:500;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.iph-scb i{font-style:normal;font-size:12px;white-space:nowrap}
.iph-scb.used{border-color:rgba(var(--accent-rgb),.32)}
.iph-scb.used span{color:var(--accent)}
.iph-scb.used b{color:var(--ink)}
.iph-scb.used i{color:var(--muted)}
.iph-log{display:flex;flex-direction:column;border-radius:18px;border:1px solid var(--line);background:rgba(255,255,255,.03);overflow:hidden}
.iph-li{display:flex;align-items:center;gap:14px;min-height:44px;padding:0 16px;font-size:15px}
.iph-li + .iph-li{border-top:1px solid var(--line)}
