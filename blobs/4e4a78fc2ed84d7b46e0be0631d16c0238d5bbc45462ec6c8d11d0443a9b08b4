<style>html,body{margin:0;height:100%;background:#000;overflow:hidden;cursor:none;font-family:system-ui,sans-serif}#root{position:fixed;top:0;right:0;bottom:0;left:0;width:100%;height:100%}#err{position:fixed;left:1%;bottom:1%;color:#555;font:14px sans-serif;direction:ltr;z-index:99}@font-face{font-family:"Readex Pro";font-weight:160 700;font-display:swap;src:url(fonts/readex-pro-arabic-wght-normal.woff2) format("woff2")}@font-face{font-family:"IBM Plex Sans Arabic";font-weight:500;font-display:swap;src:url(fonts/ibm-plex-sans-arabic-arabic-500-normal.woff2) format("woff2")}html,body{font-family:"Readex Pro","IBM Plex Sans Arabic",system-ui,sans-serif}</style>
</head><body><div id="root"></div><div id="err"></div>
<video id="keep" muted loop playsinline style="position:fixed;left:0;top:0;width:2px;height:2px;opacity:.01;pointer-events:none" src="data:video/mp4;base64,"></video>
<script>
(function(){var S=String.prototype,A=Array.prototype;
if(!S.includes)S.includes=function(s,i){return this.indexOf(s,i||0)!==-1;};
if(!S.startsWith)S.startsWith=function(s,i){i=i||0;return this.substr(i,s.length)===s;};
if(!S.endsWith)S.endsWith=function(s,n){var t=String(this);n=n===undefined?t.length:n;return t.substring(n-s.length,n)===s;};
if(!A.find)A.find=function(f,t){for(var i=0;i<this.length;i++)if(f.call(t,this[i],i,this))return this[i];};
if(!A.findIndex)A.findIndex=function(f,t){for(var i=0;i<this.length;i++)if(f.call(t,this[i],i,this))return i;return -1;};
if(!A.includes)A.includes=function(x){return this.indexOf(x)!==-1;};
if(!Array.from)Array.from=function(a,f){var r=[],i;if(a==null)return r;if(typeof a.length!=="number"&&typeof Symbol==="function"&&a[Symbol.iterator]){var it=a[Symbol.iterator](),s;while(!(s=it.next()).done)r.push(s.value);}else for(i=0;i<a.length;i++)r.push(a[i]);return f?r.map(function(x,j){return f(x,j);}):r;};
if(!Object.assign)Object.assign=function(t){for(var i=1;i<arguments.length;i++){var s=arguments[i];if(s)for(var k in s)if(Object.prototype.hasOwnProperty.call(s,k))t[k]=s[k];}return t;};
if(!Object.entries)Object.entries=function(o){return Object.keys(o).map(function(k){return[k,o[k]];});};
if(window.Uint8Array&&!Uint8Array.from)Uint8Array.from=function(a,f){return new Uint8Array(Array.from(a,f));};
})();
</script>
<script>
if(typeof Object.assign!=="function"){Object.assign=function(t){for(var i=1;i<arguments.length;i++){var s=arguments[i];if(s)for(var k in s)if(Object.prototype.hasOwnProperty.call(s,k))t[k]=s[k];}return t;};}
(function(){
  var K = null;
  setInterval(function(){
    var k = document.getElementById("keep"); if (!k) return;
    if (K === null) K = k.getAttribute("src") || "";
    var busy = document.querySelector("#root video, #root iframe");
    if (busy) {
      if (k.getAttribute("src")) { try { k.pause(); } catch (e) {} k.removeAttribute("src"); try { k.load(); } catch (e) {} }
      return;
    }
    if (!k.getAttribute("src") && K) k.setAttribute("src", K);
    if (k.paused) { try { var r = k.play(); if (r && r.catch) r.catch(function(){}); } catch (e) {} }
  }, 3000);
})();
window.onerror=function(m,u,l){var e=document.getElementById("err");if(e)e.textContent=String(m).slice(0,160)+" :"+l;};
</script>
