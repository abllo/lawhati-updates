.dl-guide{position:absolute;top:44px;bottom:20px;width:2px;margin-left:-1px;border-radius:2px;background:linear-gradient(180deg,rgba(var(--accent-rgb),0),var(--accent) 30%,rgba(var(--accent-rgb),.15));opacity:0;transition:opacity .2s;pointer-events:none}
.dl-dot{position:absolute;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;background:#fff;box-shadow:0 0 0 5px rgba(var(--accent-rgb),.28);opacity:0;transition:opacity .2s;pointer-events:none}
