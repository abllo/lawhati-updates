.dl-bub .tp{font-family:var(--f-display);font-size:18px;font-weight:500}
.dl-bub .x{font-size:12.5px;color:var(--muted)}
.dl-bub .x.ev{color:var(--accent-2)}
.dl-box.scrub .dl-guide,.dl-box.scrub .dl-dot,.dl-box.scrub .dl-bub{opacity:1}
.dl-halo{transform-box:fill-box;transform-origin:center;animation:dlPulse 3.6s ease-in-out infinite}
@keyframes dlPulse{0%,100%{opacity:.25;transform:scale(1)}50%{opacity:.55;transform:scale(1.35)}}
html.saving .dl-halo,html.playing .dl-halo,html.idle .dl-halo{animation:none}
