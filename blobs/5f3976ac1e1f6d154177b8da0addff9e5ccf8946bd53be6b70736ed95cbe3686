.tva{display:flex;gap:20px;align-items:stretch;min-height:0;padding-bottom:6px}
.tva-a{flex:1.15;min-width:0;display:flex;flex-direction:column;gap:12px}
.tva-f{flex:1;min-width:0;display:flex;flex-direction:column;gap:10px}
.tva-shot{position:relative;aspect-ratio:16/9;border-radius:18px;overflow:hidden;border:1px solid var(--line);background:#05070b;display:grid;place-items:center}
.tva-shot img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
.tva-shot .ph{color:rgba(255,255,255,.18)}
.tva-shot .ph svg{width:64px;height:64px}
.tva-shot.wait::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent 20%,rgba(255,255,255,.07) 50%,transparent 80%);background-size:200% 100%;animation:tvaSh 1.3s linear infinite}
html.saving .tva-shot.wait::after{animation:none}
@keyframes tvaSh{from{background-position:120% 0}to{background-position:-80% 0}}
.tva-cap{display:flex;align-items:center;gap:10px;min-height:44px}
.tva-cap > div{flex:1;min-width:0;display:flex;flex-direction:column}
.tva-cap b{font-family:var(--f-display);font-weight:600;font-size:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tva-cap span{font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tva-cap .ibtn{flex:none}
.tva-chips{display:flex;gap:8px;flex-wrap:wrap}
.tva-chips button{min-height:44px;padding:0 18px;font-size:15px}
.tva-log{flex:1;min-height:120px;max-height:42vh;overflow-y:auto;display:flex;flex-direction:column;gap:14px;padding:4px 2px}
.tva-q{font-size:14px;color:var(--muted)}
.tva-ans{font-size:19px;line-height:1.7;white-space:pre-wrap;-webkit-user-select:text;user-select:text}
.tva-ans.err{color:var(--warn);font-size:16px}
.tva-dots{display:inline-flex;gap:6px;padding:10px 0}
.tva-dots i{width:8px;height:8px;border-radius:50%;background:var(--accent);opacity:.3;animation:tvaDot 1s ease-in-out infinite}
.tva-dots i:nth-child(2){animation-delay:.15s}.tva-dots i:nth-child(3){animation-delay:.3s}
@keyframes tvaDot{50%{opacity:1;transform:translateY(-3px)}}
html.saving .tva-dots i{animation:none;opacity:.8}
.tva-ask{display:flex;gap:8px}
.tva-ask .in-txt{flex:1;min-width:0}
