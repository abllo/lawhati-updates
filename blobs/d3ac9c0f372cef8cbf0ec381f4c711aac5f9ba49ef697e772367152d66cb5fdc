/* your own channels: the on-screen look (tablet and TV) */
.mc-root{position:absolute;top:0;right:0;bottom:0;left:0;background:#000;color:var(--mc-ink,#fff);overflow:hidden;--mc-s:1}
.mc-root[data-size="s"]{--mc-s:.82}.mc-root[data-size="l"]{--mc-s:1.25}
.mc-stage{position:absolute;top:0;right:0;bottom:0;left:0;background:#000}
.mc-stage.mc-fr-rounded{top:3.2%;right:3.2%;bottom:3.2%;left:3.2%;border-radius:22px;overflow:hidden;box-shadow:0 0 0 3px var(--mc),0 20px 60px rgba(0,0,0,.6)}
.mc-root.mc-has-ticker .mc-stage.mc-fr-rounded{bottom:calc(3.2% + 54px)}
.mc-stage.mc-fr-cinema{top:9%;bottom:9%}
.mc-root.mc-has-ticker .mc-stage.mc-fr-cinema{bottom:calc(9% + 20px)}
.mc-stage.mc-fr-glow{top:2%;right:2%;bottom:2%;left:2%;border-radius:14px;overflow:hidden;box-shadow:0 0 40px var(--mc)}
.mc-media,.mc-media > *{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;border:0}
.mc-media video{object-fit:contain;background:#000}
.mc-stage.mc-fill .mc-media video{object-fit:cover}
.mc-card{display:flex;align-items:center;justify-content:center;text-align:center;padding:6%;background:radial-gradient(circle at 30% 20%,var(--mc-d),#000 75%);font-size:calc(46px*var(--mc-s));font-weight:700;line-height:1.5;white-space:pre-line}
.mc-card-t{max-width:85%}
.mc-bug{position:absolute;z-index:3;display:flex;align-items:center;gap:calc(10px*var(--mc-s));padding:calc(8px*var(--mc-s)) calc(14px*var(--mc-s));border-radius:999px;background:rgba(0,0,0,.42);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border:1px solid var(--mc-a)}
.mc-tl{top:3.5%;left:2.5%}.mc-tr{top:3.5%;right:2.5%}.mc-bl{bottom:3.5%;left:2.5%}.mc-br{bottom:3.5%;right:2.5%}
.mc-root.mc-has-ticker .mc-bl,.mc-root.mc-has-ticker .mc-br{bottom:calc(3.5% + 54px)}
.mc-logo{height:calc(44px*var(--mc-s));width:auto;max-width:calc(140px*var(--mc-s));object-fit:contain}
.mc-ini{width:calc(40px*var(--mc-s));height:calc(40px*var(--mc-s));border-radius:50%;background:var(--mc);color:#111;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:calc(17px*var(--mc-s))}
.mc-name{font-weight:700;font-size:calc(20px*var(--mc-s));letter-spacing:.2px}
.mc-live{background:#d33;color:#fff;font-size:calc(12px*var(--mc-s));font-weight:700;padding:2px 8px;border-radius:6px}
.mc-clock{position:absolute;z-index:3;font-size:calc(24px*var(--mc-s));font-weight:600;padding:calc(6px*var(--mc-s)) calc(14px*var(--mc-s));border-radius:999px;background:rgba(0,0,0,.42);direction:ltr}
.mc-lower{position:absolute;z-index:3;right:4%;bottom:calc(9% + 0px);max-width:70%;display:flex;flex-direction:column;gap:4px;padding:calc(12px*var(--mc-s)) calc(20px*var(--mc-s));border-right:calc(6px*var(--mc-s)) solid var(--mc);background:linear-gradient(270deg,rgba(0,0,0,.78),rgba(0,0,0,.35));border-radius:10px 0 0 10px;opacity:0;transform:translateX(30px);transition:opacity .5s,transform .5s}
.mc-root.mc-has-ticker .mc-lower{bottom:calc(9% + 54px)}
.mc-lower.on{opacity:1;transform:none}
.mc-lower b{font-size:calc(24px*var(--mc-s));font-weight:700}
.mc-lower span{font-size:calc(17px*var(--mc-s));opacity:.85}
.mc-lower span:empty,.mc-lower b:empty{display:none}
.mc-ticker{position:absolute;z-index:4;left:0;right:0;bottom:0;height:54px;display:flex;align-items:stretch;background:rgba(0,0,0,.82);border-top:3px solid var(--mc)}
.mc-tk-l{display:flex;align-items:center;padding:0 22px;background:var(--mc);color:#111;font-weight:800;font-size:19px;white-space:nowrap}
.mc-tk-w{flex:1;overflow:hidden;position:relative}
.mc-tk-t{position:absolute;top:0;bottom:0;right:0;display:flex;align-items:center;gap:60px;white-space:nowrap;font-size:20px;animation:mcTk linear infinite;padding-right:100%}
@keyframes mcTk{from{transform:translateX(0)}to{transform:translateX(50%)}}
