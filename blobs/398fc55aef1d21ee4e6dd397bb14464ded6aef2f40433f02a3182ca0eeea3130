.tsc-st{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:rgba(255,255,255,.06);color:var(--faint);transition:background-color .25s}
.tsc-st svg{width:16px;height:16px}
.tsc-st.run{color:var(--accent);background:rgba(var(--accent-rgb),.12);animation:tscPulse 1s ease-in-out infinite alternate}
.tsc-st.done{color:var(--accent-ink);background:linear-gradient(180deg,var(--accent-2),var(--accent))}
.tsc-st.fail{color:var(--warn);background:rgba(255,122,107,.16)}
.tsc-st.skip{opacity:.4}
@keyframes tscPulse{from{opacity:.55}to{opacity:1}}
html.saving .tsc-st.run{animation:none}
.tsc-ed{position:absolute;top:12px;inset-inline-end:12px;width:38px;height:38px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.06);color:var(--muted);display:grid;place-items:center;padding:0}
.tsc-ed svg{width:18px;height:18px}
.tsc-add{align-items:center;justify-content:center;border-style:dashed;background:none;color:var(--muted)}
.tsc-add svg{width:30px;height:30px}
.tsc-sleep{display:flex;align-items:center;gap:12px;padding:10px 12px 10px 16px;border-radius:16px;border:1px solid rgba(var(--accent-rgb),.35);background:rgba(var(--accent-rgb),.08)}
.tsc-sleep > svg{width:22px;height:22px;color:var(--accent);flex:none}
.tsc-sleep b{font-weight:500;flex:1}
.tsc-e{display:flex;flex-direction:column;gap:16px}
.tsc-e-top{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.tsc-e-top .in-txt{flex:1;min-width:220px;font-size:20px;height:54px}
.tsc-gl{display:flex;gap:6px;flex-wrap:wrap}
.tsc-gl button{width:44px;height:44px;border-radius:13px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--muted);display:grid;place-items:center;padding:0}
.tsc-gl button svg{width:21px;height:21px}
.tsc-gl button.on{border-color:transparent;background:rgba(var(--accent-rgb),.2);color:var(--accent)}
.tsc-rows{display:flex;flex-direction:column;gap:8px}
.tsc-row{display:flex;align-items:center;gap:10px;padding:8px 8px 8px 12px;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.05)}
.tsc-row > i{font-style:normal;width:26px;text-align:center;color:var(--faint);font-family:var(--f-mono);font-size:13px}
.tsc-row > .tsc-st{background:rgba(var(--accent-rgb),.12);color:var(--accent)}
.tsc-row > .tsc-st.run{animation:tscPulse 1s ease-in-out infinite alternate}
.tsc-row > .tsc-st.done{color:var(--accent-ink);background:linear-gradient(180deg,var(--accent-2),var(--accent))}
.tsc-row > .tsc-st.fail{color:var(--warn);background:rgba(255,122,107,.16)}
.tsc-row > .tsc-st.skip{opacity:.4}
.tsc-row > b{flex:1;font-weight:500;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tsc-row button{width:38px;height:38px;border-radius:12px;border:0;background:none;color:var(--muted);display:grid;place-items:center;padding:0}
.tsc-row button:disabled{opacity:.25}
.tsc-row button svg{width:18px;height:18px}
.tsc-h{margin:0;font-size:14px;color:var(--muted);font-weight:500}
.tsc-types{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}
.tsc-type{display:flex;align-items:center;gap:10px;min-height:50px;padding:0 14px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.06);color:var(--ink);font-size:15px;text-align:start}
.tsc-type svg{width:19px;height:19px;color:var(--accent);flex:none}
.tsc-type.on{border-color:rgba(var(--accent-rgb),.6);background:rgba(var(--accent-rgb),.12)}
.tsc-pick{display:flex;flex-direction:column;gap:10px;padding:12px;border-radius:18px;border:1px solid var(--line);background:rgba(255,255,255,.04)}
.tsc-opts{display:flex;flex-wrap:wrap;gap:8px;max-height:236px;overflow-y:auto}
.tsc-opt{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border-radius:13px;border:1px solid var(--line);background:rgba(255,255,255,.07);color:var(--ink);font-size:15px}
.tsc-opt img{width:26px;height:26px;object-fit:contain;border-radius:6px}
.tsc-vol{display:flex;align-items:center;gap:14px}
.tsc-vol input{flex:1;accent-color:var(--accent)}
.tsc-vol b{font-family:var(--f-mono);font-size:22px;min-width:44px;text-align:center}
.tsc-foot{display:flex;gap:10px;align-items:center}
.tsc-foot .del{color:var(--warn)}
