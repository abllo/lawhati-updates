<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>لوحتي</title>
<style>html,body{margin:0;height:100%;background:#000;overflow:hidden;cursor:none}video{position:fixed;top:0;left:0;width:100%;height:100%;object-fit:contain;background:#000}
#w{position:fixed;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;color:#fff;font:600 34px system-ui,sans-serif}</style>
</head><body><video id="v" autoplay playsinline></video><div id="w">…</div>
<script src="vendor/mpegts.js"></script>
<script src="vendor/hls.min.js"></script>
<script>
(function () {
  var km = /[?&]k=([^&]*)/.exec(location.search), k = km ? decodeURIComponent(km[1]) : '';
  var v = document.getElementById('v'), w = document.getElementById('w');
  var src = '/screen.m3u8?k=' + encodeURIComponent(k), hls = null;
  function full() {
    if (document.fullscreenElement || document.webkitFullscreenElement) return;
    var e = document.documentElement, f = e.requestFullscreen || e.webkitRequestFullscreen;
    try { var r = f && f.call(e); if (r && r.catch) r.catch(function () {}); } catch (x) {}
  }
  function play() { var r = v.play(); if (r && r.catch) r.catch(function () { v.muted = true; v.play(); }); }
  var ts = '/screen.ts?k=' + encodeURIComponent(k), mp = null, live = false, chase = 0;
  // fastest: one endless stream (well under a second behind); the segmented one if this TV can't
  function startTs() {
    if (!(window.mpegts && mpegts.isSupported && mpegts.isSupported() && mpegts.getFeatureList().mseLivePlayback)) return false;
    try {
      mp = mpegts.createPlayer({ type: 'mpegts', isLive: true, url: ts }, { enableWorker: false, enableStashBuffer: false, stashInitialSize: 128, liveBufferLatencyChasing: true, liveBufferLatencyMaxLatency: 1.0, liveBufferLatencyMinRemain: 0.25, lazyLoad: false, autoCleanupSourceBuffer: true, autoCleanupMaxBackwardDuration: 6, autoCleanupMinBackwardDuration: 3 });
      mp.attachMediaElement(v); mp.load();
      mp.on(mpegts.Events.ERROR, function () { try { mp.destroy(); } catch (e) {} mp = null; setTimeout(function () { if (!startTs()) startHls(); }, 1200); });
      play();
      setTimeout(function () { if (!live && mp) { try { mp.destroy(); } catch (e) {} mp = null; startHls(); } }, 8000);
      // stay at the live edge
      clearInterval(chase);
      chase = setInterval(function () { try { var b = v.buffered; if (b.length && b.end(b.length - 1) - v.currentTime > 1.5) v.currentTime = b.end(b.length - 1) - 0.3; } catch (e) {} }, 3000);
      return true;
    } catch (e) { mp = null; return false; }
  }
  function startHls() {
    if (window.Hls && Hls.isSupported()) {
      if (hls) hls.destroy();
      hls = new Hls({ liveSyncDurationCount: 1, liveMaxLatencyDurationCount: 3, maxLiveSyncPlaybackRate: 1.3, maxBufferLength: 4, backBufferLength: 0, manifestLoadingMaxRetry: 20, manifestLoadingRetryDelay: 500, levelLoadingRetryDelay: 500 });
      hls.loadSource(src); hls.attachMedia(v);
      hls.on(Hls.Events.MANIFEST_PARSED, play);
      hls.on(Hls.Events.ERROR, function (e, d) { if (!d.fatal) return; if (d.type === Hls.ErrorTypes.MEDIA_ERROR) hls.recoverMediaError(); else setTimeout(startHls, 1000); });
    } else { v.src = src; play(); }
  }
  function start() { if (!startTs()) startHls(); }
  v.addEventListener('playing', function () { live = true; w.style.display = 'none'; });
  document.addEventListener('keydown', function () { full(); v.muted = false; play(); });
  document.addEventListener('click', function () { full(); v.muted = false; play(); });
  start(); full();
})();
</script></body></html>
