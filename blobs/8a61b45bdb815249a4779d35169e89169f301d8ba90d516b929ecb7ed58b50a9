<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>لوحتي</title>
<style>html,body{margin:0;height:100%;background:#000;overflow:hidden;cursor:none}video{position:fixed;top:0;left:0;width:100%;height:100%;object-fit:contain;background:#000}
#t{position:fixed;top:28px;right:40px;color:#fff;font:600 30px system-ui,sans-serif;text-shadow:0 2px 10px #000;transition:opacity .8s;opacity:0}#t.on{opacity:.92}
#go{position:fixed;top:0;right:0;bottom:0;left:0;display:none;align-items:center;justify-content:center;color:#fff;font:600 34px system-ui,sans-serif;background:rgba(0,0,0,.5)}#go.on{display:flex}</style>
</head><body><video id="v" autoplay playsinline></video><div id="t"></div><div id="go">اضغط OK للتشغيل</div>
<script src="vendor/hls.min.js"></script>
<script>
(function () {
  var p = new URLSearchParams(location.search), v = document.getElementById('v'), t = document.getElementById('t'), go = document.getElementById('go');
  var src = '/p?k=' + encodeURIComponent(p.get('k') || '') + '&u=' + encodeURIComponent(p.get('u') || '') + (p.get('r') ? '&r=' + encodeURIComponent(p.get('r')) : '');
  var tt = p.get('t') || ''; if (tt === 'null' || tt === 'undefined') tt = ''; t.textContent = tt; t.className = tt ? 'on' : ''; setTimeout(function () { t.className = ''; }, 4000);
  var hls = null;
  function start() {
    if (window.Hls && Hls.isSupported()) {
      if (hls) hls.destroy();
      hls = new Hls({ lowLatencyMode: false, maxBufferLength: 30, backBufferLength: 30 });
      hls.loadSource(src); hls.attachMedia(v);
      hls.on(Hls.Events.ERROR, function (e, d) {
        if (!d.fatal) return;
        if (d.type === Hls.ErrorTypes.MEDIA_ERROR) hls.recoverMediaError(); else setTimeout(start, 3000);
      });
    } else { v.src = src; }
    play();
  }
  function play() { var r = v.play(); if (r && r.catch) r.catch(function () { go.className = 'on'; }); }
  // the whole TV screen: no address bar, no browser frame (the browser allows it after a key press or a click)
  function full() {
    if (document.fullscreenElement || document.webkitFullscreenElement) return;
    var el = document.documentElement, f = el.requestFullscreen || el.webkitRequestFullscreen || el.webkitRequestFullScreen;
    try { var r = f && f.call(el); if (r && r.catch) r.catch(function () { try { v.webkitEnterFullscreen && v.webkitEnterFullscreen(); } catch (e) {} }); } catch (e) {}
  }
  function resume() { full(); go.className = ''; v.muted = false; play(); }
  document.addEventListener('keydown', function () { resume(); });
  document.addEventListener('click', resume);
  document.addEventListener('mousemove', function () { full(); }, { once: true });
  v.addEventListener('playing', function () { go.className = ''; });
  start();
  full();
})();
</script></body></html>
