.fh{display:flex;flex-direction:column;gap:18px;padding-bottom:8px}
.fh-hero{display:flex;align-items:center;gap:18px;padding:20px 22px;border-radius:24px;border:1px solid var(--line);background:linear-gradient(150deg,rgba(255,255,255,.10),rgba(255,255,255,.03))}
.fh-hero.home{border-color:rgba(76,211,160,.45);background:linear-gradient(150deg,rgba(76,211,160,.16),rgba(255,255,255,.03))}
.fh-hi{width:64px;height:64px;border-radius:20px;display:grid;place-items:center;flex:none;background:rgba(255,255,255,.07);color:var(--muted)}
.fh-hero.home .fh-hi{background:rgba(76,211,160,.18);color:var(--ok)}
.fh-hi svg{width:34px;height:34px}
.fh-ht{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
.fh-ht b{font-family:var(--f-display);font-weight:600;font-size:30px;line-height:1.2}
.fh-ht span{color:var(--muted);font-size:15px}
.fh-devs{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.fh-dev{position:relative;display:flex;align-items:center;gap:12px;min-height:84px;padding:14px 16px;border-radius:20px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--ink);text-align:start}
.fh-dev > .fh-di{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;flex:none;background:rgba(var(--accent-rgb),.12);color:var(--accent)}
.fh-dev > .fh-di svg{width:22px;height:22px}
.fh-dt{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.fh-dt b{font-weight:500;font-size:16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fh-dt span{font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fh-dot{width:10px;height:10px;border-radius:50%;flex:none;background:rgba(255,255,255,.22)}
.fh-dot.on{background:var(--ok);box-shadow:0 0 0 4px rgba(76,211,160,.18)}
.fh-dot.off{background:var(--warn);box-shadow:0 0 0 4px rgba(255,122,107,.18)}
.fh-dev.add{border-style:dashed;color:var(--muted)}
.fh-dev.add > .fh-di{background:rgba(255,255,255,.06);color:var(--muted)}
.fh-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}
.fh-col{display:flex;flex-direction:column;gap:8px}
.fh-col h4{margin:0 2px 2px;display:flex;align-items:center;gap:8px;font-family:var(--f-display);font-weight:500;font-size:15px;color:var(--muted)}
.fh-col h4 svg{width:18px;height:18px;color:var(--accent)}
.fh-col .rule{padding:10px 14px}
.fh-log{display:flex;flex-direction:column}
.fh-log > div{display:flex;align-items:center;gap:12px;padding:9px 4px;border-top:1px solid var(--line);font-size:15px}
.fh-log > div:first-child{border-top:0}
.fh-log .num{min-width:74px;color:var(--muted);font-size:14px}
.fh-log .fh-dot{width:8px;height:8px}
.fh-log .v{color:var(--faint);font-size:13.5px;margin-inline-start:auto}
.fh-pick{display:flex;flex-direction:column;gap:8px}
.fh-pick .fh-dev{min-height:70px;cursor:pointer}
.fh-pick .fh-dev.cur{border-color:rgba(var(--accent-rgb),.6);background:rgba(var(--accent-rgb),.1)}
.fh-pick .fh-dev .num{color:var(--faint);font-size:13px}
