.dl-guide{position:absolute;top:44px;bottom:20px;width:2px;margin-left:-1px;border-radius:2px;background:linear-gradient(180deg,rgba(var(--accent-rgb),0),var(--accent) 30%,rgba(var(--accent-rgb),.15));opacity:0;transition:opacity .2s;pointer-events:none}
.dl-dot{position:absolute;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;background:#fff;box-shadow:0 0 0 5px rgba(var(--accent-rgb),.28);opacity:0;transition:opacity .2s;pointer-events:none}
.dl-bub{position:absolute;top:0;display:flex;align-items:center;gap:10px;padding:5px 12px;border-radius:14px;background:var(--glass-2);border:1px solid var(--line-2);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);white-space:nowrap;opacity:0;transition:opacity .2s;pointer-events:none;box-shadow:0 8px 24px rgba(0,0,0,.25)}
.dl-bub .tm{font-family:var(--f-mono);font-size:15px;font-weight:500;direction:ltr;unicode-bidi:isolate}
.dl-bub .tp{font-family:var(--f-display);font-size:18px;font-weight:500}
.dl-bub .x{font-size:12.5px;color:var(--muted)}
.dl-bub .x.ev{color:var(--accent-2)}
.dl-box.scrub .dl-guide,.dl-box.scrub .dl-dot,.dl-box.scrub .dl-bub{opacity:1}
.dl-halo{transform-box:fill-box;transform-origin:center;animation:dlPulse 3.6s ease-in-out infinite}
@keyframes dlPulse{0%,100%{opacity:.25;transform:scale(1)}50%{opacity:.55;transform:scale(1.35)}}
html.saving .dl-halo,html.playing .dl-halo,html.idle .dl-halo{animation:none}
