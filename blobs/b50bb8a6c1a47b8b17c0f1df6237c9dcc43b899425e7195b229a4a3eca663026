.tp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(232px,1fr));gap:14px;padding-bottom:18px}
.tp-grid.busy .tp-card:not(.busy){opacity:.45;pointer-events:none}
.tp-card{appearance:none;border:1px solid var(--line);background:rgba(255,255,255,.05);border-radius:20px;padding:10px;display:flex;flex-direction:column;gap:10px;color:var(--ink);text-align:right;font:inherit;transition:transform .15s var(--ease),border-color .2s}
.tp-card:active{transform:scale(.98)}
.tp-card.busy{border-color:var(--accent)}
.tp-card.busy .tp-scr::after{content:"";position:absolute;top:0;right:0;bottom:0;left:0;background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.14) 50%,transparent 70%);background-size:220% 100%;animation:tpShine 1.1s linear infinite}
@keyframes tpShine{from{background-position:120% 0}to{background-position:-120% 0}}
.tp-t{display:flex;flex-direction:column;gap:2px;padding:0 4px 2px}
.tp-t b{font-family:var(--f-display);font-weight:500;font-size:15.5px}
.tp-t .sub{font-size:12.5px}
.tp-scr{position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#05070b;font-size:10px;color:#fff}
.tp-stage{position:absolute;top:0;right:0;bottom:0;left:0;background:radial-gradient(120% 90% at 75% 20%,rgba(var(--tcr),.58),transparent 62%),linear-gradient(160deg,#141a24,#05070b)}
.tp-cinema .tp-stage{top:10%;bottom:10%}
.tp-rounded .tp-stage{top:5%;right:5%;bottom:5%;left:5%;border-radius:9px;box-shadow:0 0 0 2px var(--tc)}
.tp-glow .tp-stage{top:4%;right:4%;bottom:4%;left:4%;border-radius:8px;box-shadow:0 0 14px var(--tc)}
.tp-stage.quad{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:2px;background:#000}
.tp-stage.quad i{background:radial-gradient(120% 120% at 70% 20%,rgba(var(--tcr),.45),transparent 70%),#111722}
.tp-bug{position:absolute;top:8%;left:5%;display:flex;align-items:center;gap:5px;padding:3px 8px;border-radius:999px;background:rgba(0,0,0,.45);font-weight:700;font-size:10.5px;max-width:70%}
.tp-bug.tr{left:auto;right:5%}
.tp-bug img{height:15px;width:auto;max-width:44px;object-fit:contain}
.tp-bug span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tp-bug em{font-style:normal;background:#d33;border-radius:3px;padding:0 4px;font-size:8.5px}
.tp-clock{position:absolute;top:8%;right:5%;padding:2px 7px;border-radius:999px;background:rgba(0,0,0,.45);font-weight:600;direction:ltr}
.tp-clock.tl{right:auto;left:5%}
.tp-low{position:absolute;right:6%;bottom:26%;width:46%;padding:5px 7px;border-right:3px solid var(--tc);background:linear-gradient(270deg,rgba(0,0,0,.7),rgba(0,0,0,.25));border-radius:4px 0 0 4px;display:flex;flex-direction:column;gap:4px}
.tp-low b,.tp-low span{display:block;height:5px;border-radius:3px;background:rgba(255,255,255,.85)}
.tp-low span{width:62%;background:rgba(255,255,255,.45)}
.tp-tk{position:absolute;left:0;right:0;bottom:0;height:13%;display:flex;align-items:center;gap:8px;background:rgba(0,0,0,.82);border-top:2px solid var(--tc)}
.tp-tk b{width:20%;height:100%;background:var(--tc)}
.tp-tk span{flex:1;height:4px;border-radius:3px;background:rgba(255,255,255,.55);margin-left:8px}
