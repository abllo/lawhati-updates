.ms-day{position:relative;margin-top:4px}
.ms-bar{position:relative;height:44px;border-radius:12px;background:rgba(255,255,255,.05);border:1px solid var(--line);overflow:hidden}
.ms-blk{position:absolute;top:5px;bottom:5px;border-radius:8px;background:rgba(var(--accent-rgb),.28);border:1px solid rgba(var(--accent-rgb),.55);overflow:hidden;display:flex;align-items:center;padding:0 7px;min-width:3px}
.ms-blk span{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ms-blk.on{background:rgba(var(--accent-rgb),.5);border-color:var(--accent)}
.ms-now{position:absolute;top:0;bottom:0;width:2px;margin-right:-1px;background:var(--warn);border-radius:2px}
.ms-ticks{position:relative;height:18px;margin-top:4px}
.ms-ticks span{position:absolute;transform:translateX(50%);font-size:11.5px;color:var(--faint);font-variant-numeric:tabular-nums;white-space:nowrap}
.ms-ticks span:first-child{transform:none}
.ms-it .ms-t{white-space:pre-line;width:64px;flex:none;text-align:center;font-size:12.5px;line-height:1.35;color:var(--muted);font-variant-numeric:tabular-nums}
.ms-it.on .ms-t{color:var(--accent)}
.ms-range{display:flex;align-items:center;gap:8px}
.ms-range .ms-time{width:132px;text-align:center;direction:ltr}
.ms-dash{color:var(--muted);font-size:13px}
.ms-days{justify-content:flex-start}
.ms-pick{display:flex;flex-direction:column;gap:8px}
.ms-ini,.gd-ini{display:flex;align-items:center;justify-content:center;height:56px;border-radius:10px;background:rgba(255,255,255,.08);font-weight:600;font-size:18px;color:var(--muted)}
.ms-bul{display:flex;flex-wrap:wrap;gap:8px}
.ms-bul .chip svg{width:15px;height:15px;color:var(--accent)}
.ms-date{direction:ltr;text-align:center;width:170px}
.sm-r{align-items:flex-start}
.sm-r .sm-ic{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:rgba(var(--accent-rgb),.14);color:var(--accent)}
.sm-r .sm-ic svg{width:18px;height:18px}
.sm-r .sub{font-size:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ov-body.gd-body{padding:0 18px 18px}
.gd{display:flex;align-items:flex-start;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.03);overflow:hidden}
.gd-names{flex:none;width:230px;border-left:1px solid var(--line);background:rgba(10,14,22,.35)}
.gd-corner{height:38px;display:flex;align-items:center;padding:0 14px;font-size:13px;color:var(--accent);font-variant-numeric:tabular-nums;border-bottom:1px solid var(--line)}
.gd-ch{height:76px;display:flex;align-items:center;gap:6px;padding:0 8px 0 6px;border-bottom:1px solid var(--line)}
.gd-chb{appearance:none;border:0;background:none;color:var(--ink);display:flex;align-items:center;gap:10px;flex:1;min-width:0;padding:6px;border-radius:12px;text-align:right;font:inherit}
.gd-chb:active{background:rgba(255,255,255,.06)}
.gd-lg{width:64px;height:44px;flex:none;border-radius:10px;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;overflow:hidden}
.gd-lg img{max-width:84%;max-height:76%;object-fit:contain}
.gd-lg .gd-ini{height:auto;background:none;color:#20242C;font-size:17px}
.gd-n{display:flex;flex-direction:column;min-width:0}
.gd-n b{font-family:var(--f-display);font-weight:500;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gd-n .sub{font-size:12px;color:var(--accent);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gd-tv{width:40px;height:40px;flex:none}
.gd-scroll{flex:1;min-width:0;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch}
.gd-ruler{position:relative;height:38px;border-bottom:1px solid var(--line)}
.gd-ruler span{position:absolute;top:0;bottom:0;display:flex;align-items:center;padding-right:8px;border-right:1px solid var(--line);font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}
.gd-ruler span.half{border-right-color:rgba(255,255,255,.05)}
.gd-rows{position:relative}
.gd-line{position:relative;height:76px;border-bottom:1px solid var(--line)}
.gd-b{position:absolute;top:8px;bottom:8px;border-radius:12px;background:rgba(255,255,255,.06);border:1px solid var(--line);padding:8px 12px;display:flex;flex-direction:column;justify-content:center;gap:2px;overflow:hidden;text-align:right;color:var(--ink);font:inherit;appearance:none}
.gd-b b{font-weight:500;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gd-b span{font-size:11.5px;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}
.gd-b span:empty{display:none}
.gd-b.gen{background:rgba(255,255,255,.025);border-style:dashed}
.gd-b.gen b{color:var(--muted);font-weight:400}
.gd-b.on{background:rgba(var(--c),.30);border-color:rgba(var(--c),.85)}
.gd-b.on b{color:#fff;font-weight:600}
.gd-b.on:active{transform:scale(.99)}
.gd-now{position:absolute;top:0;bottom:0;width:2px;margin-right:-1px;background:var(--warn);z-index:2;pointer-events:none}
