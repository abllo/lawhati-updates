.wf{display:flex;flex-direction:column;gap:16px;max-width:980px}
.wf svg{width:20px;height:20px}
.wf-st{display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:24px;border:1px solid var(--line);background:rgba(255,255,255,.05)}
.wf-st .wf-ic{width:48px;height:48px;border-radius:16px;display:grid;place-items:center;background:rgba(255,255,255,.08);color:var(--muted)}
.wf-st .wf-ic svg{width:26px;height:26px}
.wf-st.online .wf-ic{background:rgba(76,211,160,.16);color:var(--ok)}
.wf-st.portal .wf-ic{background:rgba(245,176,76,.16);color:var(--amber)}
.wf-st.offline .wf-ic{background:rgba(255,122,107,.14);color:var(--warn)}
.wf-tx{flex:1;display:flex;flex-direction:column;min-width:0}
.wf-tx b{font-family:var(--f-display);font-weight:500;font-size:20px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wf-tx span{font-size:14px;color:var(--muted)}
.wf-acts{display:flex;flex-wrap:wrap;gap:10px}
.wf .btn svg{width:18px;height:18px}
.wf-tabs{display:flex;gap:6px;padding:4px;border-radius:999px;background:rgba(255,255,255,.06);align-self:flex-start}
.wf-tabs button{all:unset;cursor:pointer;padding:8px 20px;border-radius:999px;font-size:15px;color:var(--muted)}
.wf-tabs button.on{background:rgba(var(--accent-rgb),.18);color:var(--accent-2)}
.wf-list{display:flex;flex-direction:column;gap:8px}
.wf-r{display:flex;align-items:center;gap:14px;padding:12px 16px;border-radius:20px;border:1px solid var(--line);background:rgba(255,255,255,.04)}
.wf-r.here{border-color:rgba(76,211,160,.45)}
.wf-r.hot{border-color:rgba(var(--accent-rgb),.5)}
.wf-n{flex:1;display:flex;flex-direction:column;min-width:0}
.wf-n b{font-size:17px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wf-n span{font-size:13px;color:var(--muted)}
.wf-tag{font-style:normal;font-size:13px;color:var(--ok)}
.wf-d{width:24px;display:grid;place-items:center;color:var(--muted)}
.wf-b{direction:ltr;display:inline-flex;align-items:flex-end;gap:2px;width:24px;height:20px}
.wf-b s{display:block;width:4px;border-radius:1px;background:rgba(255,255,255,.2)}
.wf-b s:nth-child(1){height:5px}.wf-b s:nth-child(2){height:9px}.wf-b s:nth-child(3){height:14px}.wf-b s:nth-child(4){height:19px}
.wf-b.b1 s:nth-child(-n+1),.wf-b.b2 s:nth-child(-n+2),.wf-b.b3 s:nth-child(-n+3),.wf-b.b4 s:nth-child(-n+4){background:var(--accent)}
.wf-empty{display:flex;justify-content:center;padding:26px}
.wf-add{display:flex;flex-wrap:wrap;gap:8px}
.wf-add input,.wf-add select{flex:1;min-width:150px;padding:10px 14px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.06);color:var(--ink);font:inherit}
.wf-add select option{color:#111}
.wf-sp{display:flex;align-items:center;gap:16px;padding:14px 18px;border-radius:24px;border:1px solid var(--line);background:rgba(255,255,255,.04)}
.wf-v{display:flex;align-items:baseline;gap:8px;flex:1}
.wf-v b{font-family:var(--f-display);font-weight:200;font-size:44px;line-height:1}
.wf-v small{color:var(--muted);font-size:14px}
.wf-sp i{font-style:normal;color:var(--muted);font-size:14px}
.wf-sp.run .wf-v b{color:var(--accent-2)}
